{
  "name": "mind-map",
  "productName": "Waraqa",
  "description": "Mind maps for organizing ideas and projects",
  "author": "Waraqa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "electron .",
    "build:desktop": "node scripts/build-desktop.mjs",
    "android:init": "cap add android",
    "build:android": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "41.0.1",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.waraqa.mindmap",
    "productName": "Waraqa",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/waraqa.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/waraqa.ico",
      "uninstallerIcon": "build/waraqa.ico",
      "installerHeaderIcon": "build/waraqa.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
